#!/bin/sh
set -eu

ROOT=${KEENWG_DESTDIR:-}
BINARY=$ROOT/opt/lib/keenwg-xkeen-control/current/keenwg-xkeen-control
CONFIG=$ROOT/opt/etc/keenwg/xkeen-control.json
PIDFILE=$ROOT/opt/var/run/keenwg-xkeen-control.pid
SSD=/opt/sbin/start-stop-daemon

alive() {
    [ -r "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE")
    case "$pid" in ''|*[!0-9]*) return 1;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -z "$ROOT" ]; then
        expected=$(readlink -f "$BINARY" 2>/dev/null || true)
        running=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
        [ -n "$expected" ] && { [ "$running" = "$expected" ] || [ "$running" = "$expected (deleted)" ]; } || return 1
    fi
    return 0
}

start() {
    if alive; then return 0; fi
    rm -f "$PIDFILE"
    [ -x "$BINARY" ] && [ -f "$CONFIG" ] || return 1
    mkdir -p "${PIDFILE%/*}"
    if [ -z "$ROOT" ]; then
        [ -x "$SSD" ] || return 1
        "$SSD" -S -b -m -p "$PIDFILE" -x "$BINARY" -- -config "$CONFIG" || return 1
        pid=$(sed -n '1p' "$PIDFILE")
    else
        KEENWG_DESTDIR="$ROOT" "$BINARY" -config "$CONFIG" >/dev/null 2>&1 &
        pid=$!
        printf '%s\n' "$pid" >"$PIDFILE"
    fi
    chmod 600 "$PIDFILE"
    count=0
    while [ "$count" -lt 20 ]; do
        if kill -0 "$pid" 2>/dev/null; then return 0; fi
        count=$((count+1))
        sleep 1
    done
    rm -f "$PIDFILE"
    return 1
}

stop() {
    if ! alive; then rm -f "$PIDFILE"; return 0; fi
    pid=$(sed -n '1p' "$PIDFILE")
    if [ -z "$ROOT" ]; then
        "$SSD" -K -p "$PIDFILE" -x "$BINARY" -s TERM || return 1
    else
        kill -TERM "$pid" 2>/dev/null || return 1
    fi
    count=0
    while [ "$count" -lt 45 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then rm -f "$PIDFILE"; return 0; fi
        count=$((count+1))
        sleep 1
    done
    return 1
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    status) alive ;;
    *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
